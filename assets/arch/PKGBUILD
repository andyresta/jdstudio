# Maintainer: JDStudio contributors <andyresta@users.noreply.github.com>
# Based on Concat's, by noxygalaxy <noxycraftyt@gmail.com>
pkgname=jdstudio
pkgver=${JDSTUDIO_VERSION:?JDSTUDIO_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/andyresta/jdstudio"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${JDSTUDIO_STAGE:?JDSTUDIO_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/jdstudio" "$pkgdir/opt/jdstudio/jdstudio"
  install -d "$pkgdir/opt/jdstudio/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/jdstudio/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/jdstudio/jdstudio "$@"\n' > "$pkgdir/usr/bin/jdstudio"
  chmod 755 "$pkgdir/usr/bin/jdstudio"
  install -Dm644 "$stage/jdstudio.desktop" "$pkgdir/usr/share/applications/jdstudio.desktop"
  sed -i 's|^Exec=jdstudio|Exec=/opt/jdstudio/jdstudio %U|' "$pkgdir/usr/share/applications/jdstudio.desktop"
  install -Dm644 "$stage/jdstudio.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/jdstudio.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/jdstudio/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/jdstudio/THIRD_PARTY_NOTICES.md"
}

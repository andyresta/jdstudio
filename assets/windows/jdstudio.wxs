<?xml version="1.0" encoding="UTF-8"?>
<!--
  JDStudio's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.8 -d Root=C:\...\JDStudio
              -d Stage=C:\...\stage\JDStudio-0.2.8-windows-x86_64
              -o stage\JDStudio-0.2.8-windows-x86_64.msi assets\windows\jdstudio.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="JDStudio"
           Manufacturer="JDStudio contributors"
           Version="$(var.Version)"
           UpgradeCode="9E2B7C14-4A6D-4F81-B3C5-2D8E1F6A7B90"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of JDStudio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="jdstudio.ico" SourceFile="$(var.Root)\assets\icons\jdstudio.ico" />
    <Property Id="ARPPRODUCTICON" Value="jdstudio.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andyresta/jdstudio" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="JDStudio" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="JDStudio" />
    </StandardDirectory>

    <Feature Id="Main" Title="JDStudio" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="5A1C9D3E-7B2F-4C68-8E4A-1F3D6B9C2E75">
      <Shortcut Id="StartMenuShortcut"
                Name="JDStudio"
                Description="Video editor"
                Target="[INSTALLFOLDER]jdstudio.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="jdstudio.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\JDStudio" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
